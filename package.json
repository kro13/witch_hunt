{
  "name": "witch_hunt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/scripts/set-jev-url.mjs remote && tsc",
    "build:local": "node src/scripts/set-jev-url.mjs local && tsc && node src/scripts/set-jev-url.mjs remote",
    "watch": "tsc --watch",
    "jev": "node dist/ai/jev-server.js",
    "serve": "vite --open",
    "start": "npm run build:local && node dist/ai/jev-server.js & vite --open",
    "start:remote": "npm run build && vite --open",
    "dev": "npm run start",
    "dev:remote": "npm run start:remote",
    "stop": "kill $(lsof -t -iTCP:5173 -sTCP:LISTEN) $(lsof -t -iTCP:8787 -sTCP:LISTEN) 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
